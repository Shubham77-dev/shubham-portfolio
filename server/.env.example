# server/.env
# ─────────────────────────────────────────────────────────────────
# REQUIRED — fill these in before starting the server.
# ─────────────────────────────────────────────────────────────────

PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/portfolio_saas
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/portfolio_saas
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_saas

# JWT signing secret — use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────

# Admin invite token — sent in header X-Admin-Invite-Token during register
# to grant the admin role.  Set to any secret string.
ADMIN_INVITE_TOKEN=replace_with_your_own_admin_invite_secret

# Frontend origin for CORS (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173